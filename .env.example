# Copy to .env for local dev. On Vercel add these under Project Settings -> Environment Variables.
# Both are server-only: never prefix with VITE_ and never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional but recommended: stops the GitHub section showing "status 403" (rate limit).
# Create at github.com/settings/tokens (classic, no scopes needed). Server-only.
GITHUB_TOKEN=
